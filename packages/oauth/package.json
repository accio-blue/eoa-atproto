{
  "name": "@eoa/oauth",
  "version": "0.1.0",
  "description": "The atproto OAuth profile: the session and DPoP machines, shared by the provider and the client",
  "keywords": [
    "at-protocol",
    "atproto",
    "dpop",
    "oauth",
    "pkce"
  ],
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "vp pack src/index.ts --dts",
    "typecheck": "effect-tsrs diagnostics --project tsconfig.json --type-check",
    "format": "vp fmt",
    "lint": "vp lint",
    "test": "vitest",
    "interop": "tsx scripts/interop.ts"
  },
  "dependencies": {
    "@eoa/crypto": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@quint-machine/connect": "^0.1.0",
    "@standard-schema/spec": "catalog:",
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "effect": "catalog:"
  }
}
