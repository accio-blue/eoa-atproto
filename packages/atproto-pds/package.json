{
  "name": "@eoa/atproto-pds",
  "version": "0.1.0",
  "private": true,
  "description": "The fresh PDS's surface: XRPC over the store and the repo model, nothing lifted",
  "keywords": [
    "atproto",
    "effect-ts",
    "pds",
    "xrpc"
  ],
  "license": "MIT",
  "author": "",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "vp pack src/index.ts --dts",
    "typecheck": "effect-tsrs diagnostics --project tsconfig.json --type-check",
    "format": "vp fmt",
    "lint": "vp lint",
    "test": "vitest"
  },
  "dependencies": {
    "@eoa/core": "workspace:*",
    "@eoa/crypto": "workspace:*",
    "@eoa/identity": "workspace:*",
    "@eoa/kv": "workspace:*",
    "@eoa/oauth": "workspace:*",
    "@eoa/oauth-provider": "workspace:*",
    "@eoa/repo-store": "workspace:*",
    "@eoa/space-host": "workspace:*",
    "@eoa/xrpc-server": "workspace:*",
    "effect": "catalog:",
    "ws": "catalog:"
  },
  "devDependencies": {
    "@eoa/oauth": "workspace:*",
    "@eoa/oauth-provider": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "effect": "catalog:"
  }
}
