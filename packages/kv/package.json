{
  "name": "@eoa/kv",
  "version": "0.1.0",
  "private": true,
  "description": "The ordered key-value seam: snapshot reads, atomic multi-key batches, resumable scans, with memory and filesystem backends",
  "keywords": [
    "effect-ts",
    "key-value",
    "lsm",
    "object-store"
  ],
  "license": "MIT",
  "author": "",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "vp pack src/index.ts --dts",
    "typecheck": "effect-tsrs diagnostics --project tsconfig.json --type-check",
    "format": "vp fmt",
    "lint": "vp lint",
    "test": "vitest"
  },
  "dependencies": {
    "@eoa/object-store": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "miniflare": "^4.20260730.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "effect": "catalog:"
  }
}
