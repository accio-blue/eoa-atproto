{
  "name": "@eoa/crypto",
  "version": "0.1.0",
  "description": "Effect-based cryptographic operations for AT Protocol",
  "keywords": [
    "at-protocol",
    "atproto",
    "crypto",
    "cryptography",
    "effect-ts"
  ],
  "license": "MIT",
  "author": "",
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "vp pack src/index.ts --dts",
    "typecheck": "effect-tsrs diagnostics --project tsconfig.json --type-check",
    "format": "vp fmt",
    "lint": "vp lint",
    "test": "vitest"
  },
  "dependencies": {
    "@eoa/core": "workspace:*",
    "@noble/curves": "catalog:",
    "cobblestone-encryption": "^0.1.0",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "effect": "catalog:"
  }
}
