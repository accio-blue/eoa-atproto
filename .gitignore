# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies
node_modules
.pnp
.pnp.js

# Local env files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# The PDS's local state: sessions and credentials kept between restarts
.pds-state

# Testing
coverage

# Vitest browser-mode failure screenshots
**/__screenshots__/

# Vitest's per-project cache (it lands next to the tests, not in node_modules)
**/.vitest/

# Vite+ cache
.vite

# Vercel
.vercel

# Build Outputs
.next/
out/
/build
dist


# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Misc
.DS_Store
*.pem

# TS build info
*.tsbuildinfo

# Declarations a package build emits next to the shared test fixtures
tests/utils/*.d.ts
tests/utils/*.d.ts.map

# Local pnpm store (root-owned global store workaround)
.pnpm-store

# Obsidian
docs/.obsidian/plugins/
docs/.obsidian/workspace*.json

# Generated by vitest browser mode / the Playwright MCP
.vitest-attachments/
.playwright-mcp/

# signing keys: the public half goes to DNS, the private half never leaves here
.keys/

# Wrangler local build state, which no clone needs.
.wrangler/

# Alchemy's own local state, for the same reason — the deploy tool's bookkeeping, not the project.
.alchemy/

# The Effect source is no longer vendored: 41.8 MiB of upstream history for a reference copy.
# Clone it when you need it: git clone --depth 1 https://github.com/Effect-TS/effect repos/effect
repos/
